# ==============================================================================
# Environment Configuration (.env.example) — Firebase Architecture
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit actual production secrets to version control.
# 2. NEVER prefix private keys/tokens with NEXT_PUBLIC_.
# 3. Only variables explicitly intended for the browser may use NEXT_PUBLIC_.
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Firebase Web Client Configuration (Public / Browser & Server Safe)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyPlaceholderClientApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="siddharth-varpe-portfolio.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="siddharth-varpe-portfolio"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="siddharth-varpe-portfolio.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Firebase Admin SDK Configuration (Server-Only / Sensitive)
# When deployed on Firebase App Hosting / Cloud Run, Application Default Credentials (ADC)
# are used automatically. For standalone environments, supply service account credentials:
FIREBASE_PROJECT_ID="siddharth-varpe-portfolio"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@siddharth-varpe-portfolio.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="siddharth-varpe-portfolio.firebasestorage.app"

# Initial Authoritative Admin Credentials (Bootstrap Initialization)
ADMIN_EMAIL="admin@siddharthvarpe.com"
ADMIN_PASSWORD="replace-with-secure-admin-password"

# Transactional Email Delivery (Server-Only / Sensitive)
RESEND_API_KEY="re_placeholder_api_key"
CONTACT_EMAIL="siddharth.varpe0@gmail.com"

# Anti-Bot Protection — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAAPlaceholderSiteKey"
TURNSTILE_SECRET_KEY="0x4AAAAAAAPlaceholderSecretKey"

# Firebase App Check (Optional — Web reCAPTCHA Enterprise Site Key)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=""
