# ==============================================================================
# Environment Configuration (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit actual secrets to version control.
# 2. NEVER prefix private keys/tokens with NEXT_PUBLIC_.
# 3. Only variables explicitly intended for the browser may use NEXT_PUBLIC_.
# ==============================================================================

# Database (Server-only / Sensitive)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Authentication (Server-only / Sensitive)
BETTER_AUTH_SECRET="replace-with-generated-random-auth-secret-min-32-chars"

# Email Delivery (Server-only / Sensitive)
RESEND_API_KEY="re_placeholder_api_key"
CONTACT_EMAIL="contact@example.com"

# Anti-Spam — Cloudflare Turnstile
# Public site key for browser widget rendering
TURNSTILE_SITE_KEY="0x4AAAAAAAPlaceholderSiteKey"
# Private secret key for server-side token verification (Sensitive)
TURNSTILE_SECRET_KEY="0x4AAAAAAAPlaceholderSecretKey"

# Media Storage — Vercel Blob (Server-only / Sensitive)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_placeholder_token"

# Application URL (Public)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
