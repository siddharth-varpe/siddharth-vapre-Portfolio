# ==============================================================================
# Environment Configuration (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit actual secrets to version control.
# 2. NEVER prefix private keys/tokens with NEXT_PUBLIC_.
# 3. Only variables explicitly intended for the browser may use NEXT_PUBLIC_.
# ==============================================================================

# Database — Supabase PostgreSQL (Required)
# Public project URL (Browser & Server safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Public anon / publishable key (Browser & Server safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Privileged service-role key (Strictly SERVER-ONLY — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Direct PostgreSQL connection string (Optional / pooled connection)
# POSTGRES_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Authentication — Better Auth (Server-only / Sensitive)
BETTER_AUTH_SECRET="replace-with-generated-random-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Email Delivery — Resend (Server-only / Sensitive)
RESEND_API_KEY="re_placeholder_api_key"
CONTACT_EMAIL="siddharth.varpe0@gmail.com"

# Anti-Spam — Cloudflare Turnstile
# Public site key for browser widget rendering
TURNSTILE_SITE_KEY="0x4AAAAAAAPlaceholderSiteKey"
# Private secret key for server-side token verification (Sensitive)
TURNSTILE_SECRET_KEY="0x4AAAAAAAPlaceholderSecretKey"

# Media Storage — Vercel Blob (Server-only / Sensitive)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_placeholder_token"

# Application URL (Public)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
